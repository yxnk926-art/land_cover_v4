{
  "taxonomy_id": "unified-fine-v2",
  "version": 2,
  "status": "final",
  "description": "统一细类 v2（2026-10-30 定稿，取代 v1）：由 v1 合并 track_railway→road、sports_hard→paved_open、pasture 和 orchard→farmland，并取消 car 的重叠。每个细类在每个数据集只属于一个原生类。v1 的审计显示 car 属于两个原生类时，模型会把它当万能类，OEM 和 Global-LoveDA 的 road IoU 接近 0。其余字段含义同 v1。",
  "sources": {
    "openearthmap": "OpenEarthMap 补充材料 S1 Land Cover Classes，arXiv 2210.10732",
    "flair_hub": "FLAIR #1 数据论文的类别说明，arXiv 2211.12979（FLAIR-HUB 沿用 COSIA 体系，编号见 arXiv 2506.07080 表 VI）",
    "global_loveda": "LoveDA 附录 A.1，arXiv 2110.08733（按地理国情普查标准取 7 类，background 为其余地物）；Global-LoveDA 见 EarthVL §3.1，arXiv 2601.02783",
    "deepglobe": "DeepGlobe 2018 §2.3 Land Cover Classification，arXiv 1805.06561",
    "isprs_potsdam": "ISPRS 2D Semantic Labeling 说明：clutter/background 含水体及与其他类差异很大的物体（集装箱、网球场、游泳池）"
  },
  "datasets": [
    "openearthmap",
    "flair_hub",
    "global_loveda",
    "deepglobe",
    "isprs_potsdam"
  ],
  "fine_classes": [
    {
      "key": "building",
      "name": "Building",
      "description": "Roofed constructions: residential, commercial and industrial buildings, towers, silos, water towers. Not greenhouses.",
      "map": {
        "openearthmap": {
          "to": [
            "building"
          ],
          "basis": "official"
        },
        "flair_hub": {
          "to": [
            "building"
          ],
          "basis": "official",
          "note": "FLAIR 的 building 含塔、筒仓、水塔和坝，温室除外"
        },
        "global_loveda": {
          "to": [
            "building"
          ],
          "basis": "official"
        },
        "deepglobe": {
          "to": [
            "urban"
          ],
          "basis": "official",
          "note": "DeepGlobe 的 urban 是人工建成区"
        },
        "isprs_potsdam": {
          "to": [
            "building"
          ],
          "basis": "official"
        }
      }
    },
    {
      "key": "greenhouse",
      "name": "Greenhouse",
      "description": "Greenhouses and plastic tunnels.",
      "map": {
        "openearthmap": {
          "to": [
            "building"
          ],
          "basis": "uncertain",
          "alternatives": [
            "agriculture land"
          ],
          "note": "OEM 的定义没有提到温室，暂按有顶构筑物归 building"
        },
        "flair_hub": {
          "to": [
            "greenhouse"
          ],
          "basis": "official"
        },
        "global_loveda": {
          "to": [
            "background"
          ],
          "basis": "uncertain",
          "alternatives": [
            "agriculture",
            "building"
          ],
          "note": "LoveDA 依据的地理国情普查标准把温室大棚列为构筑物，不在 6 个前景类中"
        },
        "deepglobe": {
          "to": [
            "agriculture"
          ],
          "basis": "inferred",
          "alternatives": [
            "urban"
          ],
          "note": "DeepGlobe 的 agriculture 含苗圃、观赏园艺和圈养设施"
        },
        "isprs_potsdam": {
          "to": [
            "building"
          ],
          "basis": "uncertain",
          "alternatives": [
            "clutter"
          ],
          "note": "Potsdam 很少见，暂按有顶构筑物"
        }
      }
    },
